PORT=5050
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/avidus-premium-rbac
JWT_SECRET=change_this_to_a_random_secret_key
JWT_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5180
LOG_LEVEL=debug

# --- Scale / deploy knobs (all optional) ---
# Reverse-proxy hops in front of the API (Render/Nginx = 1). Needed for correct per-IP rate limiting.
TRUST_PROXY=0
# Per-IP request caps per 15 min (raise when many employees share one office IP).
API_RATE_MAX=2000
AUTH_RATE_MAX=50
# false = no demo credentials endpoint, no demo-user creation, no auto-seed on empty DB.
DEMO_MODE=true
AUTO_SEED=true
# Demo-only random task-status flipper (admin only). Never enable on real data.
ENABLE_SIMULATION=false
